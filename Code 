"""
DecodeLabs AI Internship - Project 2: Data Classification Using AI
Author: Victor Usoh

Pipeline (IPO model):
    INPUT   -> load the Iris dataset and scale the features
    PROCESS -> shuffle and split into train/test sets, train a K-Nearest Neighbors model
    OUTPUT  -> accuracy, confusion matrix, precision / recall / F1 score
"""

import matplotlib
matplotlib.use("Agg")  # lets the script save charts without needing a screen
import matplotlib.pyplot as plt
import pandas as pd
from sklearn.datasets import load_iris
from sklearn.metrics import (ConfusionMatrixDisplay, accuracy_score,
                             classification_report, confusion_matrix)
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.preprocessing import StandardScaler

RANDOM_STATE = 42  # makes the shuffle repeatable so results can be reproduced


def main():
    # ---------------- 1. LOAD AND UNDERSTAND THE DATA ----------------
    iris = load_iris(as_frame=True)
    X = iris.data            # 4 features: sepal/petal length and width (cm)
    y = iris.target          # 0 = setosa, 1 = versicolor, 2 = virginica
    class_names = list(iris.target_names)

    print("=== DATASET OVERVIEW ===")
    print(f"Samples: {X.shape[0]}   Features: {X.shape[1]}   Classes: {len(class_names)}")
    print("Features:", list(X.columns))
    print("Samples per class:")
    print(pd.Series(y).map(dict(enumerate(class_names))).value_counts().to_string())
    print("\nFirst 5 rows:")
    print(X.head().to_string())

    # ---------------- 2. SPLIT INTO TRAINING AND TESTING SETS ----------------
    # 80% train / 20% test. shuffle=True removes order bias, and stratify keeps the
    # class balance the same in both sets.
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.2, shuffle=True, stratify=y, random_state=RANDOM_STATE
    )
    print(f"\nTraining samples: {len(X_train)}   Testing samples: {len(X_test)}")

    # ---------------- 3. FEATURE SCALING ----------------
    # Fit the scaler on the TRAINING data only, then apply it to both sets.
    # Fitting on the test set would leak information into training.
    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)
    X_test_scaled = scaler.transform(X_test)

    # ---------------- 4. CHOOSE K (TUNING THE ENGINE) ----------------
    # Try several values of K and compare accuracy on the test set.
    print("\n=== TRYING DIFFERENT K VALUES ===")
    results = {}
    for k in range(1, 16, 2):
        model_k = KNeighborsClassifier(n_neighbors=k)
        model_k.fit(X_train_scaled, y_train)
        results[k] = accuracy_score(y_test, model_k.predict(X_test_scaled))
        print(f"K = {k:2d}  accuracy = {results[k]:.3f}")

    # ---------------- 5. TRAIN THE FINAL MODEL (K = 5) ----------------
    model = KNeighborsClassifier(n_neighbors=5)   # INSTANTIATE
    model.fit(X_train_scaled, y_train)            # FIT
    predictions = model.predict(X_test_scaled)    # PREDICT

    # ---------------- 6. EVALUATE ----------------
    print("\n=== FINAL MODEL (K = 5) ===")
    print(f"Accuracy: {accuracy_score(y_test, predictions):.3f}")
    print("\nConfusion matrix (rows = actual, columns = predicted):")
    print(confusion_matrix(y_test, predictions))
    print("\nClassification report (precision, recall, F1):")
    print(classification_report(y_test, predictions, target_names=class_names))

    # Save the confusion matrix as a picture for the repository / LinkedIn post
    ConfusionMatrixDisplay.from_predictions(
        y_test, predictions, display_labels=class_names, cmap="Blues"
    )
    plt.title("Iris classification: confusion matrix (KNN, K=5)")
    plt.tight_layout()
    plt.savefig("confusion_matrix.png", dpi=150)
    print("Saved chart: confusion_matrix.png")

    # ---------------- 7. TEST WITH COMPLETELY NEW DATA ----------------
    new_flower = pd.DataFrame(
        [[5.1, 3.5, 1.4, 0.2]], columns=X.columns
    )  # sepal length, sepal width, petal length, petal width
    new_scaled = scaler.transform(new_flower)
    guess = model.predict(new_scaled)[0]
    print(f"\nNew flower {new_flower.values.tolist()[0]} is predicted to be: {class_names[guess]}")


if __name__ == "__main__":
    main()
